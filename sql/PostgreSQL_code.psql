

-- 1. Table to store fligth start and end points
CREATE TABLE scenarios(
		scenario_id SERIAL PRIMARY KEY,
		scenario_name VARCHAR(100) NOT NULL,
		start_x NUMERIC NOT NULL,
		start_y NUMERIC NOT NULL,
		end_x NUMERIC NOT NULL,
		end_y NUMERIC NOT NULL
);

-- Table to store storm date linked to a specific scenario
CREATE TABLE weather_zones(
	zone_id SERIAL PRIMARY KEY,
	scenario_id INTEGER REFERENCES scenarios(scenario_id),
	center_x NUMERIC NOT NULL,
	center_y NUMERIC NOT NULL,
	radius NUMERIC NOT NULL
	
);

-- 3. Table to store storm data linked to a specific scenario
DROP TABLE IF EXISTS optimzed_trajectories;
CREATE TABLE optimized_trajectories(
		waypoint_id SERIAL PRIMARY KEY,
		scenario_id INTEGER REFERENCES scenarios(scenario_id),
		sequence_order INTEGER NOT NULL, -- 0 for start, 1, 2, 3 .. for inermediate,
		pos_x NUMERIC NOT NULL,
		pos_y NUMERIC NOT NULL
		
);

